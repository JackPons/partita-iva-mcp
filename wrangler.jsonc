{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partita-iva-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
     "PRIVACY_TITOLARE": "Jacopo Ruozzi",
     "PRIVACY_EMAIL": "jacopo.ruozzi@verika.it"
   },

  // Conteggio chiamate.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "partita-iva-mcp-stats",
      "database_id": "5ac162da-6b16-43f2-9bca-6df76bdcc7e4",
      "migrations_dir": "migrations"
    }
  ],


  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // Pulizia giornaliera delle righe più vecchie di 90 giorni (03:17 UTC).
  "triggers": { "crons": ["17 3 * * *"] }
}
